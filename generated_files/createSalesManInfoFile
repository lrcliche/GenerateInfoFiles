/**
 * Genera un archivo plano con la información de los vendedores.
 * 
 * El archivo creado contiene una cantidad determinada de vendedores,
 * donde cada línea representa un vendedor con la siguiente estructura:
 * 
 * TipoDocumento;NumeroDocumento;Nombres;Apellidos
 * 
 * Los datos son generados de manera pseudoaleatoria para facilitar
 * las pruebas del sistema sin necesidad de ingresar información manual.
 * 
 * @param salesmanCount Cantidad de vendedores que se desean generar en el archivo.
 * @throws IOException Si ocurre un error durante la creación o escritura del archivo.
 */
public void createSalesManInfoFile(int salesmanCount) throws IOException {

    FileWriter writer = new FileWriter(PATH + "vendedores.txt");

    String[] nombres = {"Carlos", "Ana", "Luis", "Maria", "Pedro", "Laura"};
    String[] apellidos = {"Gomez", "Perez", "Rodriguez", "Lopez", "Martinez"};

    for (int i = 0; i < salesmanCount; i++) {
        String nombre = nombres[random.nextInt(nombres.length)];
        String apellido = apellidos[random.nextInt(apellidos.length)];

        long id = 1000000000 + random.nextInt(900000000);

        writer.write("CC;" + id + ";" + nombre + ";" + apellido + "\n");
    }

    writer.close();
}

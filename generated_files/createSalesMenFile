/**
 * Genera un archivo plano con las ventas de un vendedor específico.
 * 
 * El archivo contiene en la primera línea la información del vendedor:
 * TipoDocumento;NumeroDocumento
 * 
 * A partir de la segunda línea, se registran las ventas realizadas,
 * donde cada línea tiene el siguiente formato:
 * 
 * IDProducto;Cantidad
 * 
 * Los datos de ventas son generados de manera pseudoaleatoria,
 * incluyendo el identificador del producto y la cantidad vendida.
 * 
 * @param randomSalesCount Número de registros de ventas que se generarán.
 * @param name Nombre del vendedor (usado como referencia).
 * @param id Número de identificación del vendedor.
 * @throws IOException Si ocurre un error durante la creación o escritura del archivo.
 */
public void createSalesMenFile(int randomSalesCount, String name, long id) throws IOException {

    FileWriter writer = new FileWriter(PATH + "ventas_" + id + ".txt");

    // Cabecera con información del vendedor
    writer.write("CC;" + id + "\n");

    for (int i = 0; i < randomSalesCount; i++) {

        int productId = random.nextInt(10) + 1; // IDs entre 1 y 10
        int quantity = random.nextInt(20) + 1;  // Cantidades entre 1 y 20

        writer.write(productId + ";" + quantity + "\n");
    }

    writer.close();
}
